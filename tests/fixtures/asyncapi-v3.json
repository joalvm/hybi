{
  "asyncapi": "3.1.0",
  "id": "urn:example:websocket-workbench:v3",
  "info": {
    "title": "Example V3 Events",
    "version": "2.0.0",
    "description": "V3 event catalog"
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "localhost:4400",
      "protocol": "ws"
    }
  },
  "channels": {
    "userEvents": {
      "address": "/users",
      "messages": {
        "UserCreated": {
          "name": "user.created",
          "payload": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "serverPings": {
      "address": "/pings",
      "messages": {
        "Pong": {
          "name": "pong",
          "payload": {
            "type": "object",
            "properties": {
              "at": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "operations": {
    "receiveUserCreated": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/userEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/userEvents/messages/UserCreated"
        }
      ]
    },
    "sendUserCreated": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/userEvents"
      },
      "messages": [
        {
          "$ref": "#/channels/userEvents/messages/UserCreated"
        }
      ]
    },
    "sendPong": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/serverPings"
      },
      "messages": [
        {
          "$ref": "#/channels/serverPings/messages/Pong"
        }
      ]
    }
  }
}
